// Cloudflare Workers (static assets only, no server code). Workers Builds runs the build command
// `npm run build:site` first, then `npx wrangler deploy`, which uploads ./site as defined here.
// _headers and _redirects inside ./site are applied by Cloudflare. See docs/deployment.md.
{
  "name": "burgerweg",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
